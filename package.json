{
  "name": "sakumaki-catalog",
  "private": true,
  "type": "module",
  "scripts": {
    "watchlist": "bun run src/watchlist.ts",
    "catalog": "bun run src/catalog.ts",
    "merge": "bun run src/merge.ts",
    "table": "bun run src/table.ts",
    "watchlist-votes": "bun run src/watchlist-votes.ts",
    "watchlist-progress": "bun run src/watchlist-progress.ts",
    "watchlist-fields": "bun run src/watchlist-fields.ts",
    "ratings": "bun run src/ratings-external.ts",
    "typecheck": "bun x tsc --noEmit",
    "dev": "browser-sync start --server data --files data/index.html --port 8787 --no-open --no-ui --no-notify"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "browser-sync": "^3.0.4",
    "typescript": "^5"
  },
  "dependencies": {
    "@tanstack/virtual-core": "3.19.6",
    "sortablejs": "1.15.6",
    "tom-select": "2.4.3"
  }
}
