# Cookie di sessione "etp_rt", copiato dal browser dopo il login:
# DevTools > Application > Cookies > sito > etp_rt
AUTH_COOKIE=
# Host delle API: il sottodominio beta-api, perché quello del sito mette /auth e /content dietro la challenge di Cloudflare. Senza slash finale.
API_BASE=
# Host del sito, per i link alle serie nella tabella. Senza slash finale.
SITE_BASE=
# Service credentials NordVPN (Nord Account > NordVPN > Manual setup), non quelle di login: servono per il proxy per paese.
NORD_USER=
NORD_PASS=
# Facoltativo: client id dell'API di MyAnimeList (myanimelist.net/apiconfig). Senza, il voto MAL passa da Jikan.
MAL_CLIENT_ID=
# Secondi di pausa fra un paese e l'altro nel download del catalogo (default 300; 0 per le prove locali).
COUNTRY_PAUSE_S=
